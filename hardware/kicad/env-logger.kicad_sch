	(text "Environment Logger - schematic (module level)"
		(exclude_from_sim no)
		(at 15.24 12.7 0)
		(effects
			(font
				(size 3.0 3.0)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "7f303b68-3a12-49ea-b7a5-68f9565b597e")
	)
	(text "ESP32-S3-DevKitM-1 + BME280 + DS3231 on one I2C bus (400 kHz), 2 status LEDs, 1 button"
		(exclude_from_sim no)
		(at 15.24 20.32 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "4e19542d-69c9-4641-8aa0-5342ef27b536")
	)
	(text "Notes\n1. I2C pull-ups: no external resistors. The modules already have them\n   (BME280: 10k per line, DS3231: 4.7k per line, about 3.2k in parallel).\n2. I2C addresses: BME280 = 0x76, DS3231 = 0x68. SDA = GPIO8, SCL = GPIO9.\n3. Power: 5V enters via the DevKitM-1 USB connector; the on-board regulator\n   supplies 3V3 to both modules.\n4. UART0 (GPIO43/44) is wired on the DevKitM-1 to its USB-UART bridge;\n   the log is read through the same USB connector.\n5. LED series resistors 220 ohm. Button is active low, internal pull-up\n   is enabled in firmware.\n6. DS3231 pins 32K and SQW are not used."
		(exclude_from_sim no)
		(at 15.24 140 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "b176a03d-eda2-4063-8a72-48ac276943ca")
	)
